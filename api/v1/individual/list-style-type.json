  "description": "The list-style-type CSS property sets the marker (such as a disc, character, or custom counter style) of a list item element.",
  "syntax": "<counter-style> | <string> | none",
  "initial": "disc",
  "inherited": "yes",
  "appliesTo": "list items",
  "status": "standard",
