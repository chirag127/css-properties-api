{
  "id": "font-synthesis-position",
  "name": "font-synthesis-position",
  "description": "The font-synthesis-position CSS property lets you specify whether or not a browser may synthesize the subscript and superscript \"position\" typefaces when they are missing in a font family, while using \"font-variant-position\" to set the positions.",
  "syntax": "auto | none",
  "initial": "auto",
  "inherited": "yes",
  "appliesTo": "all elements and text",
  "status": "experimental",
  "specUrl": [
    "https://drafts.csswg.org/css-fonts/#font-synthesis-position"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/font-synthesis-position",
  "support": {
    "chrome": {
      "added": false,
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "118",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": false,
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
