{
  "id": "speak-as",
  "name": "speak-as",
  "description": "The speak-as CSS property is used to define how HTML content is spoken. The one to three enumerated key terms determine the manner by which elements and text get rendered by aural technologies, such as \"screen reader\", \"screen readers\" and digital assistants.",
  "syntax": "normal | spell-out || digits || [ literal-punctuation | no-punctuation ]",
  "initial": "normal",
  "inherited": "yes",
  "appliesTo": "all elements",
  "status": "experimental",
  "specUrl": [
    "https://drafts.csswg.org/css-speech-1/#speaking-props-speak-as"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/speak-as",
  "support": {
    "chrome": {
      "added": false,
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": false,
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "11.1",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
