{
  "id": "text-decoration",
  "name": "text-decoration",
  "description": "The text-decoration CSS shorthand property sets the appearance of decorative lines on text. It is a shorthand for \"text-decoration-line\", \"text-decoration-color\", \"text-decoration-style\", and the newer \"text-decoration-thickness\" property.",
  "syntax": "<'text-decoration-line'> || <'text-decoration-thickness'> || <'text-decoration-style'> || <'text-decoration-color'>",
