{
  "id": "mask-border-outset",
  "name": "mask-border-outset",
  "description": "The mask-border-outset CSS property specifies the distance by which an element's mask border is set out from its border box.",
  "syntax": "<'border-image-outset'>",
  "initial": "0",
  "inherited": "no",
  "appliesTo": "All elements. In SVG, it applies to container elements excluding the defs element, all graphics elements and the use element",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-masking/#the-mask-border-outset"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/mask-border-outset",
