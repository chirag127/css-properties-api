{
  "id": "flood-color",
  "name": "flood-color",
  "description": "The flood-color CSS property defines the color of the current filter primitive subregion in \"feFlood\" and \"feDropShadow\" elements within a \"filter\". If present, it overrides the element's \"flood-color\" attribute.",
  "syntax": "<color>",
  "initial": "black",
  "inherited": "no",
  "appliesTo": "feFlood and feDropShadow elements",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/filter-effects/#FloodColorProperty"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/flood-color",
  "support": {
    "chrome": {
      "added": "5",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "3",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "6",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": "12",
      "removed": null,
      "prefixed": null
    }
  }
}
