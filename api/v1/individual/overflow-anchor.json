{
  "id": "overflow-anchor",
  "name": "overflow-anchor",
  "description": "The overflow-anchor CSS property provides a way to opt out of the browser's scroll anchoring behavior, which adjusts scroll position to minimize content shifts.",
  "syntax": "auto | none",
  "initial": "auto",
  "inherited": "no",
  "appliesTo": "all elements",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-scroll-anchoring/#exclusion-api"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/overflow-anchor",
  "support": {
    "chrome": {
      "added": "56",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "66",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "27",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
