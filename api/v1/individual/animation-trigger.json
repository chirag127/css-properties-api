{
  "id": "animation-trigger",
  "name": "animation-trigger",
  "description": "The animation-trigger CSS property specifies whether CSS animations declared on an element are triggered animations (or not) and, if so, what their triggers are and how they should behave when the trigger becomes active or inactive. This is used to create scroll-triggered animations.",
  "syntax": "[ none | [ <dashed-ident> <animation-action>+ ]+ ]#",
  "initial": "none",
  "inherited": "no",
  "appliesTo": "all elements",
  "status": "experimental",
  "specUrl": [
    "https://drafts.csswg.org/animation-triggers-1/#propdef-animation-trigger"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/animation-trigger",
  "support": {
    "chrome": {
      "added": "146",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": false,
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": false,
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
