{
  "id": "rule-width",
  "name": "rule-width",
  "description": "The rule-width CSS shorthand property defines the widths of any lines drawn in the gutters of multi-row grid, flex, and multi-col layouts, setting the widths of the column and row rules to the same value.",
  "syntax": "<'column-rule-width'>",
  "initial": "see individual properties",
  "inherited": "no",
  "appliesTo": "Same as column-rule-width and row-rule-width",
  "status": "experimental",
