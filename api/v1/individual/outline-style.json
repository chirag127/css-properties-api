{
  "id": "outline-style",
  "name": "outline-style",
  "description": "The outline-style CSS property sets the style of an element's outline. An outline is a line that is drawn around an element, outside the \"border\".",
  "syntax": "auto | <outline-line-style>",
  "initial": "none",
  "inherited": "no",
  "appliesTo": "all elements",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-ui/#outline-style"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/outline-style",
  "support": {
    "chrome": {
      "added": "1",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "1.5",
      "removed": null,
      "prefixed": "1"
    },
    "safari": {
      "added": "1.2",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": "12",
      "removed": null,
      "prefixed": null
    }
  }
}
