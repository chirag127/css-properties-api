  "id": "interest-delay",
  "name": "interest-delay",
  "description": "The interest-delay CSS property specifies the delay between the user showing interest in an interest invoker element and the \"HTMLElement.interestevent\", \"interest\" event firing, and the delay between the user losing interest and the \"HTMLElement.loseinterestevent\", \"loseinterest\" event firing.",
  "syntax": "<'interest-delay-start'>{1,2}",
