{
  "id": "font-variant-numeric",
  "name": "font-variant-numeric",
  "description": "The font-variant-numeric CSS property controls the usage of alternate glyphs for numbers, fractions, and ordinal markers.",
  "syntax": "normal | [ <numeric-figure-values> || <numeric-spacing-values> || <numeric-fraction-values> || ordinal || slashed-zero ]",
  "initial": "normal",
  "inherited": "yes",
  "appliesTo": "all elements and text",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-fonts/#font-variant-numeric-prop"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/font-variant-numeric",
  "support": {
    "chrome": {
      "added": "52",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "34",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "9.1",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
