{
  "id": "inline-size",
  "name": "inline-size",
  "description": "The inline-size CSS property defines the size of an element's block along the inline axis. If the \"writing-mode\" is horizontal, it corresponds to the \"width\"; if the writing mode is vertical, it corresponds to the \"height\". A related property is \"block-size\", which defines the other dimension of the element.",
  "syntax": "auto | <length-percentage>",
  "initial": "auto",
  "inherited": "no",
  "appliesTo": "‘text’ elements",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-logical/#dimension-properties",
    "https://drafts.csswg.org/css-sizing/#sizing-values"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/inline-size",
  "support": {
    "chrome": {
      "added": "57",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "41",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "12.1",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
