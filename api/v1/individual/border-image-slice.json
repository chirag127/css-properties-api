{
  "id": "border-image-slice",
  "name": "border-image-slice",
  "description": "The border-image-slice CSS property divides the image specified by \"border-image-source\" into regions. These regions form the components of an element's border image.",
  "syntax": "[<number [0,∞]> | <percentage [0,∞]>]{1,4} && fill?",
  "initial": "100%",
  "inherited": "no",
  "appliesTo": "All elements, except internal table elements when border-collapse is collapse",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-backgrounds/#border-image-slice"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/border-image-slice",
  "support": {
    "chrome": {
      "added": "15",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "15",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "6",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": "12",
      "removed": null,
      "prefixed": null
    }
  }
}
