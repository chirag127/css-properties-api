{
  "id": "text-overflow",
  "name": "text-overflow",
  "description": "The text-overflow CSS property sets how hidden overflow content is signaled to users.",
  "syntax": "[ clip | ellipsis | <string> | fade | <fade()> ]{1,2}",
  "initial": "clip",
  "inherited": "no",
  "appliesTo": "block containers",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-overflow/#text-overflow",
    "https://w3c.github.io/svgwg/svg2-draft/text.html#TextOverflowProperty"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/text-overflow",
  "support": {
    "chrome": {
      "added": "1",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "7",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "1.3",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": "12",
      "removed": null,
      "prefixed": null
    }
  }
}
