{
  "id": "x",
  "name": "x",
  "description": "The x CSS property defines the x-axis coordinate of the top left corner of the SVG \"rect\" shape, \"image\" image, \"foreignObject\" viewport or nested \"svg\" viewport relative to the nearest ancestor's user coordinate system. If present, it overrides the element's \"x\" attribute.",
  "syntax": "<length-percentage>",
  "initial": "0",
  "inherited": "no",
  "appliesTo": "‘svg’, ‘rect’, ‘image’, ‘foreignObject’ elements",
  "status": "standard",
