{
  "id": "columns",
  "name": "columns",
  "description": "The columns CSS shorthand property sets the maximum number of columns to use when drawing an element's contents, along with the minimum width and maximum height of the element's columns.",
  "syntax": "[ <'column-width'> || <'column-count'> ] [ / <'column-height'> ]?",
  "initial": "see individual properties",
  "inherited": "see individual properties",
  "appliesTo": "see individual properties",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-multicol-2/#propdef-columns"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/columns",
  "support": {
    "chrome": {
      "added": "50",
      "removed": null,
      "prefixed": "50"
    },
    "firefox": {
      "added": "52",
      "removed": null,
      "prefixed": "9"
    },
    "safari": {
      "added": "9",
      "removed": null,
      "prefixed": "3"
    },
    "edge": {
      "added": "12",
      "removed": null,
      "prefixed": "12"
    }
  }
}
