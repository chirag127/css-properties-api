{
  "id": "text-decoration-line",
  "name": "text-decoration-line",
  "description": "The text-decoration-line CSS property sets the kind of decoration that is used on text in an element, such as an underline or overline.",
  "syntax": "none | [ underline || overline || line-through || blink ] | spelling-error | grammar-error",
  "initial": "none",
  "inherited": "no (but see prose, above)",
  "appliesTo": "all elements",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-text-decor/#text-decoration-line-property"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/text-decoration-line",
  "support": {
    "chrome": {
      "added": "57",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "36",
      "removed": null,
      "prefixed": "6"
    },
    "safari": {
      "added": "12.1",
      "removed": null,
      "prefixed": "8"
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
