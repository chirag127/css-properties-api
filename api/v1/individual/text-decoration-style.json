{
  "id": "text-decoration-style",
  "name": "text-decoration-style",
  "description": "The text-decoration-style CSS property sets the style of the lines specified by \"text-decoration-line\". The style applies to all lines that are set with text-decoration-line.",
  "syntax": "solid | double | dotted | dashed | wavy",
  "initial": "solid",
  "inherited": "no",
  "appliesTo": "all elements",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-text-decor/#text-decoration-style-property"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/text-decoration-style",
  "support": {
    "chrome": {
      "added": "57",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "36",
      "removed": null,
      "prefixed": "6"
    },
    "safari": {
      "added": "12.1",
      "removed": null,
      "prefixed": "8"
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
