{
  "id": "font-variant-ligatures",
  "name": "font-variant-ligatures",
  "description": "The font-variant-ligatures CSS property controls which \"ligature\", \"ligatures\" and contextual forms are used in the textual content of the elements it applies to. This leads to more harmonized forms in the resulting text.",
  "syntax": "normal | none | [ <common-lig-values> || <discretionary-lig-values> || <historical-lig-values> || <contextual-alt-values> ]",
  "initial": "normal",
  "inherited": "yes",
  "appliesTo": "all elements and text",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-fonts/#font-variant-ligatures-prop"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/font-variant-ligatures",
  "support": {
    "chrome": {
      "added": "34",
      "removed": null,
      "prefixed": "31"
    },
    "firefox": {
      "added": "34",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "9.1",
      "removed": null,
      "prefixed": "7"
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
