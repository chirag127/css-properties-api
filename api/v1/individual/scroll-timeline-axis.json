{
  "id": "scroll-timeline-axis",
  "name": "scroll-timeline-axis",
  "description": "The scroll-timeline-axis CSS property is used to specify the scrollbar direction that will be used to provide the timeline for a scroll driven animation, which is progressed through by scrolling a scrollable element (scroller).",
  "syntax": "[ block | inline | x | y ]#",
  "initial": "block",
  "inherited": "no",
  "appliesTo": "all elements",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/scroll-animations/#propdef-scroll-timeline-axis"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/scroll-timeline-axis",
  "support": {
    "chrome": {
      "added": "115",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "159",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "26",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
