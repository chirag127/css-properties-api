  "specUrl": [
    "https://drafts.csswg.org/css-grid/#track-sizing",
    "https://drafts.csswg.org/css-grid/#subgrids"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/grid-template-columns",
