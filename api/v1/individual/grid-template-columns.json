  "description": "The grid-template-columns CSS property defines the line names and track sizing functions of the \"grid column\", \"grid columns\".",
  "syntax": "none | <track-list> | <auto-track-list> | subgrid <line-name-list>?",
  "initial": "none",
  "inherited": "no",
  "appliesTo": "grid containers",
