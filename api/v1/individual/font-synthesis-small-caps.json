{
  "id": "font-synthesis-small-caps",
  "name": "font-synthesis-small-caps",
  "description": "The font-synthesis-small-caps CSS property lets you specify whether or not the browser may synthesize small-caps typeface when it is missing in a font family. Small-caps glyphs typically use the form of uppercase letters but are reduced to the size of lowercase letters.",
  "syntax": "auto | none",
  "initial": "auto",
  "inherited": "yes",
  "appliesTo": "all elements and text",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-fonts/#font-synthesis-small-caps"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/font-synthesis-small-caps",
  "support": {
    "chrome": {
      "added": "97",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "111",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "16.4",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
