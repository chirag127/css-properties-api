{
  "id": "font-variant-caps",
  "name": "font-variant-caps",
  "description": "The font-variant-caps CSS property controls the use of alternate glyphs used for small or petite capitals or for titling.",
  "syntax": "normal | small-caps | all-small-caps | petite-caps | all-petite-caps | unicase | titling-caps",
  "initial": "normal",
  "inherited": "yes",
  "appliesTo": "all elements and text",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-fonts/#font-variant-caps-prop"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/font-variant-caps",
  "support": {
    "chrome": {
      "added": "52",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "34",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "9.1",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
