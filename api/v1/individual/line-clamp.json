{
  "id": "line-clamp",
  "name": "line-clamp",
  "description": "The line-clamp CSS property allows limiting of the contents of a \"block\" to the specified number of lines. Optionally, it also allows inserting content into the last line to indicate that content was truncated.",
  "syntax": "none | [<'max-lines'> || <'block-ellipsis'>] -webkit-legacy?",
  "initial": "none",
  "inherited": "see individual properties",
  "appliesTo": "see individual properties",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/css-overflow-4/#propdef-line-clamp"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/line-clamp",
  "support": {
    "chrome": {
      "added": "preview",
      "removed": null,
      "prefixed": "6"
    },
    "firefox": {
      "added": "preview",
      "removed": null,
      "prefixed": "68"
    },
    "safari": {
      "added": "preview",
      "removed": null,
      "prefixed": "5"
    },
    "edge": {
      "added": null,
      "removed": null,
      "prefixed": null
    }
  }
}
