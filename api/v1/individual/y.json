{
  "id": "y",
  "name": "y",
  "description": "The y CSS property defines the y-axis coordinate of the top left corner of the SVG \"rect\" shape, \"image\" image, \"foreignObject\" viewport and nested \"svg\" viewport relative to the nearest ancestor's user coordinate system. If present, it overrides the element's \"y\" attribute.",
  "syntax": "<length-percentage>",
