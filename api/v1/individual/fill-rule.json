{
  "id": "fill-rule",
  "name": "fill-rule",
  "description": "The fill-rule CSS property defines the rule used to determine which parts of the SVG shape's canvas are included inside a shape to be filled. If present, it overrides the element's \"fill-rule\" attribute.",
  "syntax": "nonzero | evenodd",
  "initial": "nonzero",
  "inherited": "yes",
  "appliesTo": "shapes and text content elements",
  "status": "standard",
  "specUrl": [
    "https://drafts.csswg.org/fill-stroke-3/#fill-rule"
  ],
  "mdnUrl": "https://developer.mozilla.org/docs/Web/CSS/Reference/Properties/fill-rule",
  "support": {
    "chrome": {
      "added": "1",
      "removed": null,
      "prefixed": null
    },
    "firefox": {
      "added": "3",
      "removed": null,
      "prefixed": null
    },
    "safari": {
      "added": "4",
      "removed": null,
      "prefixed": null
    },
    "edge": {
      "added": "≤15",
      "removed": null,
      "prefixed": null
    }
  }
}
